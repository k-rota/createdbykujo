{
  "name": "createdbykujo",
  "version": "1.0.0",
  "description": "Personal website for createdbykujo, custom websites by Kujo.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "build:server": "tsc -p tsconfig.server.json",
    "server": "npm run build:server && node dist-server/server.js",
    "dev": "npm run build && npm run server"
  },
  "author": "Kujo",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "typescript": "^5.9.3"
  }
}
