# ---- createdbykujo backend config ----
# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=3000

# Comma-separated origins allowed to POST to the contact API
ALLOWED_ORIGIN=http://localhost:3000

# Where inquiries get delivered
CONTACT_TO=kjsierota@gmail.com

# SMTP credentials (e.g. Gmail App Password, SendGrid, Mailgun, etc.)
# Leave SMTP_HOST blank to run in "log only" mode while testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
